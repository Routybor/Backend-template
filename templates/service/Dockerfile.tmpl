FROM golang:1.26-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates

COPY pkg/go.mod pkg/go.sum* ./pkg/
COPY __MODULE__/go.mod __MODULE__/go.sum* ./__MODULE__/
RUN printf 'go 1.26.0\n\nuse (\n\t./pkg\n\t./__MODULE__\n)\n' > go.work \
    && cd __MODULE__ && go mod download \
    && cd ../pkg && go mod download

COPY pkg/ ./pkg/
COPY __MODULE__/ ./__MODULE__/
RUN cd __MODULE__ && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X main.version=1.0.0" -o /app/__NAME__ ./cmd/__NAME__

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S app && adduser -S app -G app

WORKDIR /app

COPY --from=builder /app/__NAME__ .

RUN chown -R app:app /app

USER app

EXPOSE 8082 9092

ENV PORT=8082
ENV GRPC_PORT=9092

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8082/health || exit 1

ENTRYPOINT ["./__NAME__"]

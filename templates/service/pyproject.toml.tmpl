[project]
name = "__MODULE__"
version = "0.1.0"
requires-python = ">=3.13"
dependencies = [
    "backend-common",
    "fastapi>=0.129.0",
    "grpcio>=1.75.0",
    "uvicorn[standard]>=0.38.0",
]

[dependency-groups]
dev = ["pytest>=9.0.0"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/__PACKAGE__"]

[tool.uv.sources]
backend-common = { workspace = true }
